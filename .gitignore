# Local secrets. Never commit these.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
.wrangler/

# Salesforce CLI local state (org auth lives in the user's home, not here)
.sf/
.sfdx/

# OS and editor
.DS_Store
*.log

# Record ids of the seeded org (org-specific, written by npm run sf:seed)
.seed.local.json

# The External Client App's OAuth policy names the Run As username (written by npm run sf:integration-user)
salesforce/main/default/extlClntAppOauthPolicies/
